import express from 'express'

const app = express ()
const porta = 3000 
// criar rotas  de servidor
app.get('/', (req, res)=> (
    res.send('Olá, abacaxi')
)) 
app.get('/doces', (req, res)=> (
    res.send(`<h1>olá, morango do amor</h1>
      <p> Nossa loja de morangos...</p>
        `)
))

app.listen(porta, () => ('console.log(servidor está vivo)'))